# ============================================================
# APAAR-SETU backend — environment variables
# Source of truth: DOCS_md/system.md section 7 (+ backend_guide.md section 1)
# Copy this file to `.env` and fill in the secrets. NEVER commit `.env`.
# ============================================================

# ────────────────────────────────────────────
# SECRETS — you must fill these
# ────────────────────────────────────────────

# Postgres connection string.
#
# RENDER (the backend deploys here) — paste the Supabase session-pooler URL
#   into Dashboard -> apaar-backend -> Environment -> DATABASE_URL.
# app/config.py rewrites Render's postgres:// scheme to postgresql:// and
# adds sslmode=require automatically, so no editing is needed.
DATABASE_URL=postgres://apaar_admin:[DB-PASSWORD]@dpg-xxxxxx-a.<region>.postgres.render.com:5432/apaar_setu
#
# SUPABASE alternative — dashboard -> project -> Connect -> Connection string
#   -> URI. Use the Session pooler (port 6543) = use this (the direct 5432
#   endpoint is usually refused from outside AWS). Password must be
#   URL-encoded: @ -> %40.
# DATABASE_URL=postgresql+psycopg2://postgres:[DB-PASSWORD]@db.<project-ref>.supabase.co:6543/postgres

# JWT signing key — generate once:  openssl rand -hex 32
JWT_SECRET=[GENERATE: openssl rand -hex 32]

# Ed25519 private key for signing verification records (base64-encoded PEM).
# Generate:
#   openssl genpkey -algorithm ed25519 -out apaar_signing.pem
#   base64 -i apaar_signing.pem | tr -d '\n'   # (macOS: base64 -i apaar_signing.pem)
# Keep apaar_signing.pem OUT of git. Public key is served at /api/v1/verify/public-key.
SIGNING_PRIVATE_KEY=[GENERATE: base64 of ed25519 PEM]

# LLM API key — Groq: console.groq.com/keys (free tier). Or set literally "ollama"
# for local Ollama (no key needed).
LLM_KEY=[FILL: groq key, or "ollama"]

# Password for the read-only llm_reader DB role (backend_guide.md section 3).
# Create in Supabase SQL Editor (init_db.py does this automatically too):
#   CREATE ROLE llm_reader LOGIN PASSWORD '<strong password>';
#   GRANT SELECT ON v_institution_summary, v_course_intake_status,
#                   v_flag_summary, v_duplicate_enrolments TO llm_reader;
LLM_READER_PASSWORD=[FILL: password from the CREATE ROLE above]

# ────────────────────────────────────────────
# SUPABASE (project metadata — used by tooling/docs, not by the app at runtime)
# ────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=[FILL: supabase anon key]

# ────────────────────────────────────────────
# RENDER DASHBOARD CHECKLIST (service: apaar-backend)
# ────────────────────────────────────────────
#   DATABASE_URL         fill with the Supabase session-pooler URI (port 6543)
#   JWT_SECRET           auto-generated by the blueprint (generateValue)
#   LLM_KEY              fill: Groq key (or "ollama")
#   SIGNING_PRIVATE_KEY  fill: base64 of the ed25519 PEM (see above)
#   CORS_ORIGINS         fill: the Vercel URL of the frontend, e.g.
#                        https://apaar-setu.vercel.app,http://localhost:5173
# On every deploy the container runs scripts/init_db.py (tables + views,
# idempotent) and scripts/seed.py (demo dataset; additive and skipped when
# already present) and then serves uvicorn on $PORT. Health check: GET /health.

# ────────────────────────────────────────────
# APP CONFIG (defaults from the docs — usually no need to change)
# ────────────────────────────────────────────
JWT_EXPIRE_MINUTES=60
APAAR_REGEX=^\d{12}$
APAAR_MODE=mock
LLM_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
FUZZY_THRESHOLD=90
ANOMALY_THRESHOLD=0.65
CORS_ORIGINS=http://localhost:5173

# ────────────────────────────────────────────
# OFFLINE / FALLBACK (switch LLM_URL + LLM_KEY + LLM_MODEL to these for Ollama)
# LLM_URL=http://localhost:11434/v1
# LLM_KEY=ollama
# LLM_MODEL=llama3.1:8b
